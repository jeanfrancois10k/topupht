# ============================================
# GAME TOP-UP HAITI - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local with real secrets

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Top-Up Provider ---
TOPUP_PROVIDER_NAME=
TOPUP_PROVIDER_API_URL=
TOPUP_PROVIDER_API_KEY=
TOPUP_PROVIDER_SECRET=
TOPUP_PROVIDER_WEBHOOK_SECRET=

# --- Payment Provider ---
PAYMENT_PROVIDER_NAME=
PAYMENT_PROVIDER_API_URL=
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Platform Settings ---
NEXT_PUBLIC_PLATFORM_NAME=Game Top-Up
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@game-topup.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_DEFAULT_CURRENCY=HTG

# --- Features ---
NEXT_PUBLIC_ENABLE_REGISTRATION=true
NEXT_PUBLIC_ENABLE_SELLER_REGISTRATION=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# --- Admin ---
ADMIN_EMAIL=admin@game-topup.com
ADMIN_INITIAL_PASSWORD=changeme123

# --- Environment ---
NODE_ENV=development

# --- Rate Limiting ---
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000